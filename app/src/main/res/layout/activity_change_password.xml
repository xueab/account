<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@android:color/white">


    <!-- 返回按钮和标题 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="修改密码"
            android:textSize="24sp"
            android:layout_centerInParent="true"/>
    </RelativeLayout>

    <!-- 账号输入 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="账号"
        android:layout_marginBottom="1dp"
        android:textSize="16sp"/>

    <EditText
        android:id="@+id/et_account"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="15dp"
        android:background="@drawable/edittext_border"
        android:hint="请输入账号"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"/>

    <!-- 验证码区域 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="验证码"
        android:textSize="16sp"
        android:layout_marginBottom="1dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_verification"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:hint="请输入验证码"
            android:background="@drawable/edittext_border"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>

        <Button
            android:id="@+id/btn_get_verification"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="获取验证码"
            android:layout_marginStart="10dp"
            android:background="@drawable/button_border"
            android:layout_marginBottom="2dp"
            android:textColor="#888888"/>
    </LinearLayout>

    <!-- 新密码输入 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="新密码"
        android:textSize="16sp"
        android:layout_marginBottom="1dp"/>

    <EditText
        android:id="@+id/et_new_password"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="5dp"
        android:inputType="textPassword"
        android:background="@drawable/edittext_border"
        android:hint="请输入新密码"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"/>

    <!-- 密码强度指示器 -->
    <LinearLayout
        android:id="@+id/password_strength_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_strength_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="密码强度: "
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tv_strength_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="低"
            android:textSize="12sp"
            android:textColor="#FF0000"/>

        <View
            android:id="@+id/view_strength_low"
            android:layout_width="30dp"
            android:layout_height="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="7dp"
            android:background="#FF0000"/>

        <View
            android:id="@+id/view_strength_medium"
            android:layout_width="30dp"
            android:layout_height="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="7dp"
            android:background="#888888"/>

        <View
            android:id="@+id/view_strength_high"
            android:layout_width="30dp"
            android:layout_height="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="7dp"
            android:background="#888888"/>
    </LinearLayout>

    <!-- 确认新密码 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="确认新密码"
        android:textSize="16sp"
        android:layout_marginTop="10dp"/>

    <EditText
        android:id="@+id/et_confirm_new_password"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="1dp"
        android:inputType="textPassword"
        android:background="@drawable/edittext_border"
        android:hint="请再次输入新密码"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"/>

    <TextView
        android:id="@+id/tv_password_match"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="两次密码不一致"
        android:textSize="12sp"
        android:textColor="#FF0000"
        android:visibility="gone"
        android:layout_marginTop="2dp"
        android:layout_marginStart="5dp"/>

    <!-- 修改密码按钮 -->
    <Button
        android:id="@+id/btn_change_password"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="修改密码"
        android:layout_marginTop="10dp"
        android:background="@drawable/button_primary"
        android:textColor="@android:color/white"/>
</LinearLayout>